# This is an example .env file for a Next.js application. You should create a .env file in the root of your project and copy the contents of this file into it, replacing the placeholder values with your actual configuration.
FIRECRAWL_API_KEY=

# This is the base URL of your application. It should include the protocol (http:// or https://) and the port if it's not the default (80 for http and 443 for https). For example, if you're running the app locally, it might be http://localhost:3000. If you're deploying to a production environment, it should be the URL of your deployed app (e.g. https://myapp.com).
NEXT_PUBLIC_APP_URL=

# This is a secret key used for securing cron jobs. It should be a long, random string and should be kept secret. It will be used to verify that incoming requests to the cron endpoint are legitimate.
CRON_SECRET=

# This is the email address that will be used as the "from" address when sending emails through Resend. It should be a valid email address that you have access to. Make sure to use an email address that is allowed by your email provider and that you have set up properly to avoid issues with email deliverability.
RESEND_FROM_EMAIL=onboarding@resend.dev

# This is the API key for Resend, which can be found in the Resend dashboard under "Settings" > "API Keys". It should be kept secret and should never be exposed to the frontend. 
RESEND_API_KEY=

# This is the URL of your Supabase project. It can be found in the Supabase dashboard under "Settings" > "API". It should include the protocol (https://) and the unique identifier for your project (e.g. https://your-project.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=

# This is the publishable key, which can be used in the frontend. It has limited permissions. It can be found in the Supabase dashboard under "Settings" > "API". It should start with "sb_publishable_".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# This is the anon key, which can be used in the frontend. It has limited permissions. It can be found in the Supabase dashboard under "Settings" > "API". It should start
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This is the service role key, which has full access to the database. It should only be used in server-side code and should never be exposed to the frontend. It can be found in the Supabase dashboard under "Settings" > "API". It should start with "sb_service_role_".
SUPABASE_SERVICE_ROLE_KEY=

# Enable this to use the service worker for caching and offline support in the frontend. This is optional and can be set to "true" or "false". If you want to enable it, set it to "true". If you don't want to use the service worker, you can leave it empty or set it to "false".
NEXT_PUBLIC_ENABLE_SW=